{
  "name": "wechat-price-api",
  "version": "0.1.0",
  "private": true,
  "description": "Cloudflare Worker for a WeChat Official Account price-comparison API.",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "wrangler dev",
    "types": "wrangler types",
    "types:check": "wrangler types --check",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check": "npm run types:check && npm run typecheck && npm test",
    "deploy:dry": "wrangler deploy --dry-run --env production",
    "deploy:staging": "wrangler deploy --env staging",
    "deploy:production": "wrangler deploy --env production"
  },
  "devDependencies": {
    "@types/node": "26.4.0",
    "typescript": "7.0.2",
    "vitest": "4.1.11",
    "wrangler": "4.127.1"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260828.1": true
  }
}
