{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "appstore-wechat-bot-dev",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "secrets": {
    "required": ["WECHAT_TOKEN"]
  },
  "vars": {
    "ENVIRONMENT": "local"
  },
  "kv_namespaces": [
    {
      "binding": "BOT_STATE",
      "id": "53804a1d969446ee9cd8ca54cd989ff9"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "env": {
    "staging": {
      "name": "appstore-wechat-bot-staging",
      "secrets": {
        "required": ["WECHAT_TOKEN"]
      },
      "vars": {
        "ENVIRONMENT": "staging"
      },
      "kv_namespaces": [
        {
          "binding": "BOT_STATE",
          "id": "53804a1d969446ee9cd8ca54cd989ff9"
        }
      ]
    },
    "production": {
      "name": "appstore-wechat-bot",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [
        {
          "pattern": "wxbot.290935.xyz",
          "custom_domain": true
        }
      ],
      "secrets": {
        "required": ["WECHAT_TOKEN"]
      },
      "vars": {
        "ENVIRONMENT": "production"
      },
      "kv_namespaces": [
        {
          "binding": "BOT_STATE",
          "id": "b9d52e61661e468e8f5e327486c6ca1e"
        }
      ]
    }
  }
}
