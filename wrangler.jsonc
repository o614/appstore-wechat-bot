{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "appstore-wechat-bot-dev",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "secrets": {
    "required": ["WECHAT_TOKEN"]
  },
  "vars": {
    "ENVIRONMENT": "local"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "env": {
    "staging": {
      "name": "appstore-wechat-bot-staging",
      "secrets": {
        "required": ["WECHAT_TOKEN"]
      },
      "vars": {
        "ENVIRONMENT": "staging"
      }
    },
    "production": {
      "name": "appstore-wechat-bot",
      "secrets": {
        "required": ["WECHAT_TOKEN"]
      },
      "vars": {
        "ENVIRONMENT": "production"
      }
    }
  }
}
